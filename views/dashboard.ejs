<div class="space-y-6 sm:space-y-8">

  <!-- Header & Primary Action -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-50 text-indigo-700 border border-indigo-200/60 mb-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Professional Social Media Hub
      </span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Social Accounts &amp; Overview</h1>
      <p class="text-slate-500 mt-1 text-xs sm:text-sm md:text-base">Real-time connected channel analytics and automated publishing queue.</p>
    </div>
    <div class="w-full sm:w-auto flex items-center gap-2.5 flex-wrap sm:flex-nowrap">
      <a href="/direct-uploader"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-pink-600 via-purple-600 to-indigo-600 text-white font-bold px-4 sm:px-5 py-2.5 sm:py-3 rounded-xl shadow-md shadow-pink-500/20 hover:shadow-lg hover:shadow-pink-500/30 hover:-translate-y-0.5 active:translate-y-0 transition-all text-xs sm:text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        <span>Direct Uploader</span>
      </a>
      <a href="/next"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white border border-slate-200 text-slate-700 hover:text-indigo-600 hover:border-indigo-200 font-bold px-4 py-2.5 sm:py-3 rounded-xl shadow-xs hover:shadow-sm transition-all text-xs sm:text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"/></svg>
        <span>Series Queue</span>
      </a>
    </div>
  </div>

  <!-- SECTION 1: CONNECTED SOCIAL MEDIA CHANNELS -->
  <div>
    <div class="flex items-center justify-between mb-3 sm:mb-4">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">Connected Accounts</h2>
      <span class="text-[11px] sm:text-xs font-semibold text-emerald-600 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Live Synced via Official APIs
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">

      <!-- YouTube Channel Card -->
      <div class="rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-card hover:shadow-elevated transition-all relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-32 h-32 bg-red-500/5 rounded-bl-full pointer-events-none"></div>

        <div class="flex items-start gap-3.5 sm:gap-4">
          <!-- Profile Picture -->
          <div class="relative shrink-0">
            <img src="/api/youtube-avatar" alt="YouTube Avatar" referrerpolicy="no-referrer"
                 onerror="this.style.display='none'; document.getElementById('ytFallbackBrand').classList.remove('hidden');"
                 class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl object-cover border-2 border-red-100 shadow-sm">
            <div id="ytFallbackBrand" class="hidden w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-tr from-red-600 via-rose-600 to-red-700 text-white flex items-center justify-center shadow-sm border border-red-200">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </div>
            <div class="absolute -bottom-1 -right-1 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-red-600 text-white flex items-center justify-center text-xs shadow">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-3.5 sm:h-3.5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </div>
          </div>

          <!-- Channel Info -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap sm:flex-nowrap">
              <h3 class="text-base sm:text-lg font-extrabold text-slate-900 truncate">
                <%= ytProfile ? ytProfile.title : "YouTube Shorts" %>
              </h3>
              <span class="px-2 py-0.5 rounded-full text-[9px] sm:text-[10px] font-extrabold uppercase bg-red-50 text-red-700 border border-red-200 shrink-0">
                Verified
              </span>
            </div>
            <p class="text-xs font-semibold text-slate-500 mt-0.5 truncate">
              <%= ytProfile ? ytProfile.customUrl : "@channel" %>
            </p>

            <a href="https://youtube.com/<%= ytProfile ? ytProfile.customUrl : '' %>" target="_blank" rel="noreferrer"
              class="inline-flex items-center gap-1 text-xs text-red-600 font-bold hover:underline mt-1">
              <span>Visit Channel</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>

        <!-- Channel Stats Grid -->
        <div class="grid grid-cols-3 gap-1.5 sm:gap-2 mt-4 sm:mt-5 pt-4 border-t border-slate-100 text-center">
          <div class="bg-slate-50/80 rounded-xl p-2 sm:p-2.5">
            <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-slate-400 block truncate">Subscribers</span>
            <span class="text-sm sm:text-base md:text-lg font-extrabold text-slate-900 mt-0.5 block truncate">
              <%= ytProfile ? ytProfile.subscribers : "—" %>
            </span>
          </div>
          <div class="bg-slate-50/80 rounded-xl p-2 sm:p-2.5">
            <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-slate-400 block truncate">Total Views</span>
            <span class="text-sm sm:text-base md:text-lg font-extrabold text-slate-900 mt-0.5 block truncate" title="<%= ytProfile ? ytProfile.views : '' %>">
              <%= ytProfile ? ytProfile.views : "—" %>
            </span>
          </div>
          <div class="bg-slate-50/80 rounded-xl p-2 sm:p-2.5">
            <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-slate-400 block truncate">Videos</span>
            <span class="text-sm sm:text-base md:text-lg font-extrabold text-slate-900 mt-0.5 block truncate">
              <%= ytProfile ? ytProfile.videoCount : "—" %>
            </span>
          </div>
        </div>
      </div>

      <!-- Instagram Account Card -->
      <div class="rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-card hover:shadow-elevated transition-all relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-32 h-32 bg-rose-500/5 rounded-bl-full pointer-events-none"></div>

        <div class="flex items-start gap-3.5 sm:gap-4">
          <!-- Profile Picture -->
          <div class="relative shrink-0">
            <% if (igProfile && igProfile.profile_picture_url) { %>
              <img src="<%= igProfile.profile_picture_url %>" alt="Instagram Avatar" referrerpolicy="no-referrer"
                   onerror="this.style.display='none'; document.getElementById('igFallbackBrand').classList.remove('hidden');"
                   class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl object-cover border-2 border-pink-100 shadow-sm">
            <% } %>
            <div id="igFallbackBrand" class="<%= (igProfile && igProfile.profile_picture_url) ? 'hidden' : '' %> w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-tr from-amber-400 via-rose-500 to-purple-600 text-white flex items-center justify-center font-bold text-xl shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 sm:w-8 sm:h-8 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </div>
            <div class="absolute -bottom-1 -right-1 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 text-white flex items-center justify-center text-xs shadow">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-3.5 sm:h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </div>
          </div>

          <!-- Account Info -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap sm:flex-nowrap">
              <h3 class="text-base sm:text-lg font-extrabold text-slate-900 truncate">
                <%= igProfile ? igProfile.name : "Instagram Account" %>
              </h3>
              <span class="px-2 py-0.5 rounded-full text-[9px] sm:text-[10px] font-extrabold uppercase bg-pink-50 text-pink-700 border border-pink-200 shrink-0">
                Professional
              </span>
            </div>
            <p class="text-xs font-semibold text-slate-500 mt-0.5 truncate">
              @<%= igProfile ? igProfile.username : "account" %>
            </p>

            <a href="https://instagram.com/<%= igProfile ? igProfile.username : '' %>" target="_blank" rel="noreferrer"
              class="inline-flex items-center gap-1 text-xs text-rose-600 font-bold hover:underline mt-1">
              <span>View Profile</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>

        <!-- Account Stats Grid -->
        <div class="grid grid-cols-2 gap-1.5 sm:gap-2 mt-4 sm:mt-5 pt-4 border-t border-slate-100 text-center">
          <div class="bg-slate-50/80 rounded-xl p-2 sm:p-2.5">
            <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-slate-400 block truncate">Followers</span>
            <span class="text-sm sm:text-base md:text-lg font-extrabold text-slate-900 mt-0.5 block truncate">
              <%= igProfile && igProfile.followers_count ? Number(igProfile.followers_count).toLocaleString() : "—" %>
            </span>
          </div>
          <div class="bg-slate-50/80 rounded-xl p-2 sm:p-2.5">
            <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-slate-400 block truncate">Media Posts</span>
            <span class="text-sm sm:text-base md:text-lg font-extrabold text-slate-900 mt-0.5 block truncate">
              <%= igProfile && igProfile.media_count ? Number(igProfile.media_count).toLocaleString() : "—" %>
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- SECTION 2: QUEUE METRICS CARDS (CLICKABLE) -->
  <div>
    <div class="flex items-center justify-between mb-3 sm:mb-4">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">Queue &amp; Library Status</h2>
      <span class="text-xs font-medium text-slate-500 hidden xs:inline-block">Click card to filter table</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">

      <!-- Card: Total Reels -->
      <div onclick="filterQueue('all')" class="cursor-pointer rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-card hover:shadow-elevated hover:border-indigo-300 transition-all group active:scale-[0.99]">
        <div class="flex items-center justify-between">
          <span class="text-slate-500 text-xs font-bold uppercase tracking-wider">Total Video Library</span>
          <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2"/></svg>
          </div>
        </div>
        <p class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2.5 sm:mt-3 tracking-tight"><%= total %></p>
        <div class="mt-2.5 sm:mt-3 flex items-center justify-between text-xs text-indigo-600 font-bold">
          <span>View all videos &rarr;</span>
          <span class="text-slate-400 font-normal">Entire library</span>
        </div>
      </div>

      <!-- Card: Instagram Pending -->
      <div onclick="filterQueue('ig-pending')" class="cursor-pointer rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-card hover:shadow-elevated hover:border-pink-300 transition-all group active:scale-[0.99]">
        <div class="flex items-center justify-between">
          <span class="text-slate-500 text-xs font-bold uppercase tracking-wider">Instagram Pending</span>
          <div class="w-10 h-10 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </div>
        </div>
        <p class="text-3xl sm:text-4xl font-extrabold text-rose-600 mt-2.5 sm:mt-3 tracking-tight"><%= instaPending %></p>
        <div class="mt-2.5 sm:mt-3 flex items-center justify-between text-xs text-rose-600 font-bold">
          <span>Filter IG pending &rarr;</span>
          <span class="px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 font-semibold text-[10px]"><%= instaPending %> waiting</span>
        </div>
      </div>

      <!-- Card: YouTube Pending -->
      <div onclick="filterQueue('yt-pending')" class="cursor-pointer rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-card hover:shadow-elevated hover:border-red-300 transition-all group active:scale-[0.99]">
        <div class="flex items-center justify-between">
          <span class="text-slate-500 text-xs font-bold uppercase tracking-wider">YouTube Pending</span>
          <div class="w-10 h-10 rounded-xl bg-red-50 text-red-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>
        </div>
        <p class="text-3xl sm:text-4xl font-extrabold text-red-600 mt-2.5 sm:mt-3 tracking-tight"><%= ytPending %></p>
        <div class="mt-2.5 sm:mt-3 flex items-center justify-between text-xs text-red-600 font-bold">
          <span>Filter YT pending &rarr;</span>
          <span class="px-2 py-0.5 rounded-full bg-red-50 text-red-700 font-semibold text-[10px]"><%= ytPending %> waiting</span>
        </div>
      </div>

    </div>
  </div>

  <!-- SECTION 3: INTERACTIVE QUEUE & REELS LIST -->
  <div id="queueSection" class="rounded-2xl border border-slate-200/90 bg-white shadow-card p-4 sm:p-7 space-y-4 sm:space-y-5">
    
    <!-- Controls Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 sm:gap-4 border-b border-slate-100 pb-4 sm:pb-5">
      <div>
        <h2 class="text-base sm:text-lg font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-indigo-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
          <span>Publishing Queue &amp; Content Pipeline</span>
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">Filter reels by status or search by day and keywords.</p>
      </div>

      <!-- Touch-Friendly Filter Tabs (Scrollable on small phones) -->
      <div class="overflow-x-auto no-scrollbar -mx-1 px-1 py-0.5 flex items-center gap-1 sm:gap-1.5 bg-slate-100/80 p-1 rounded-xl text-xs font-bold text-slate-600 shrink-0">
        <button onclick="filterQueue('all')" id="tab-all" class="filter-tab px-3 py-1.5 rounded-lg transition whitespace-nowrap bg-white text-indigo-700 shadow-sm">
          All (<%= total %>)
        </button>
        <button onclick="filterQueue('pending')" id="tab-pending" class="filter-tab px-3 py-1.5 rounded-lg transition whitespace-nowrap hover:text-slate-900">
          Pending (<%= Math.max(instaPending, ytPending) %>)
        </button>
        <button onclick="filterQueue('ig-pending')" id="tab-ig-pending" class="filter-tab px-3 py-1.5 rounded-lg transition whitespace-nowrap hover:text-slate-900">
          IG (<%= instaPending %>)
        </button>
        <button onclick="filterQueue('yt-pending')" id="tab-yt-pending" class="filter-tab px-3 py-1.5 rounded-lg transition whitespace-nowrap hover:text-slate-900">
          YT (<%= ytPending %>)
        </button>
        <button onclick="filterQueue('posted')" id="tab-posted" class="filter-tab px-3 py-1.5 rounded-lg transition whitespace-nowrap hover:text-slate-900">
          Completed (<%= total - Math.max(instaPending, ytPending) %>)
        </button>
      </div>
    </div>

    <!-- Search Input -->
    <div class="relative">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="text" id="queueSearch" placeholder="Search by title, filename, or Day..." onkeyup="searchQueue()"
        class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm font-medium text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition">
    </div>

    <!-- Responsive Interactive Table with Touch Scroll -->
    <div class="overflow-x-auto rounded-xl border border-slate-200/80 shadow-sm">
      <table class="w-full text-left text-xs sm:text-sm">
        <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-bold uppercase tracking-wider text-[10px] sm:text-[11px]">
          <tr>
            <th class="py-3 px-3 sm:px-4 whitespace-nowrap">Row / Day</th>
            <th class="py-3 px-3 sm:px-4 min-w-[200px] sm:min-w-[260px]">Video &amp; Title</th>
            <th class="py-3 px-3 sm:px-4 whitespace-nowrap">Instagram</th>
            <th class="py-3 px-3 sm:px-4 whitespace-nowrap">YouTube</th>
            <th class="py-3 px-3 sm:px-4 text-right whitespace-nowrap">Action</th>
          </tr>
        </thead>
        <tbody id="reelsTableBody" class="divide-y divide-slate-100 font-medium">
          <% reelsList.forEach(function(item) { %>
            <tr class="reel-row hover:bg-indigo-50/30 transition-colors"
                data-ig="<%= item.igStatus %>"
                data-yt="<%= item.ytStatus %>"
                data-pending="<%= item.isPending ? 'true' : 'false' %>"
                data-title="<%= item.title.toLowerCase() %>"
                data-file="<%= item.fileName.toLowerCase() %>">
              
              <!-- Row Index -->
              <td class="py-3 px-3 sm:px-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2 py-0.5 rounded-md font-bold text-xs <%= item.isPending ? 'bg-indigo-50 text-indigo-700 border border-indigo-200' : 'bg-slate-100 text-slate-500' %>">
                  #<%= item.rowIndex %>
                </span>
              </td>

              <!-- Title & Filename -->
              <td class="py-3 px-3 sm:px-4">
                <div class="font-bold text-slate-900 text-xs sm:text-sm leading-snug break-words">
                  <%= item.title %>
                </div>
                <div class="text-[11px] sm:text-xs text-slate-400 font-mono mt-0.5 truncate max-w-[180px] sm:max-w-xs">
                  <%= item.fileName %>
                </div>
              </td>

              <!-- Instagram Status -->
              <td class="py-3 px-3 sm:px-4 whitespace-nowrap">
                <% if (item.igStatus === 'Posted') { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] sm:text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>Posted</span>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] sm:text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span>Pending</span>
                  </span>
                <% } %>
              </td>

              <!-- YouTube Status -->
              <td class="py-3 px-3 sm:px-4 whitespace-nowrap">
                <% if (item.ytStatus === 'Posted') { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] sm:text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>Posted</span>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] sm:text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span>Pending</span>
                  </span>
                <% } %>
              </td>

              <!-- Action Link -->
              <td class="py-3 px-3 sm:px-4 whitespace-nowrap text-right">
                <% if (item.isPending) { %>
                  <a href="/next" class="inline-flex items-center gap-1 text-xs font-bold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-lg transition active:scale-95">
                    <span>Publish</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                  </a>
                <% } else { %>
                  <span class="text-xs text-slate-400 font-semibold">Done</span>
                <% } %>
              </td>

            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Empty Filter Result Message -->
    <div id="noResults" class="hidden py-8 text-center text-slate-400 text-xs sm:text-sm">
      No matching reels found for this search or filter.
    </div>

  </div>

</div>

<script>
  let currentFilter = 'all';

  function filterQueue(filter) {
    currentFilter = filter;

    document.querySelectorAll('.filter-tab').forEach(tab => {
      tab.classList.remove('bg-white', 'text-indigo-700', 'shadow-sm');
      tab.classList.add('text-slate-600');
    });

    const activeTab = document.getElementById('tab-' + filter);
    if (activeTab) {
      activeTab.classList.add('bg-white', 'text-indigo-700', 'shadow-sm');
      activeTab.classList.remove('text-slate-600');
    }

    applyFilters();

    const section = document.getElementById('queueSection');
    if (section) {
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function searchQueue() {
    applyFilters();
  }

  function applyFilters() {
    const query = document.getElementById('queueSearch').value.toLowerCase().trim();
    const rows = document.querySelectorAll('.reel-row');
    let visibleCount = 0;

    rows.forEach(row => {
      const ig = row.getAttribute('data-ig');
      const yt = row.getAttribute('data-yt');
      const isPending = row.getAttribute('data-pending') === 'true';
      const title = row.getAttribute('data-title');
      const file = row.getAttribute('data-file');

      let matchesFilter = true;
      if (currentFilter === 'pending') matchesFilter = isPending;
      else if (currentFilter === 'ig-pending') matchesFilter = (ig !== 'Posted');
      else if (currentFilter === 'yt-pending') matchesFilter = (yt !== 'Posted');
      else if (currentFilter === 'posted') matchesFilter = (!isPending);

      const matchesSearch = !query || title.includes(query) || file.includes(query);

      if (matchesFilter && matchesSearch) {
        row.classList.remove('hidden');
        visibleCount++;
      } else {
        row.classList.add('hidden');
      }
    });

    const noResults = document.getElementById('noResults');
    if (visibleCount === 0) noResults.classList.remove('hidden');
    else noResults.classList.add('hidden');
  }
</script>
