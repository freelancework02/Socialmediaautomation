<div class="mb-8">
  <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Dashboard</h1>
  <p class="text-slate-400 mt-1 text-sm sm:text-base">Overview of your reels queue.</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">

  <div class="rounded-2xl border border-border bg-panel p-6 shadow-glow">
    <div class="flex items-center justify-between">
      <span class="text-slate-400 text-sm font-medium">Total Reels</span>
      <span class="text-2xl">🎞️</span>
    </div>
    <p class="text-4xl font-extrabold text-white mt-3"><%= total %></p>
  </div>

  <div class="rounded-2xl border border-border bg-panel p-6 shadow-glow">
    <div class="flex items-center justify-between">
      <span class="text-slate-400 text-sm font-medium">Instagram Pending</span>
      <span class="text-2xl">📸</span>
    </div>
    <p class="text-4xl font-extrabold text-pink-400 mt-3"><%= instaPending %></p>
  </div>

  <div class="rounded-2xl border border-border bg-panel p-6 shadow-glow">
    <div class="flex items-center justify-between">
      <span class="text-slate-400 text-sm font-medium">YouTube Pending</span>
      <span class="text-2xl">▶️</span>
    </div>
    <p class="text-4xl font-extrabold text-red-400 mt-3"><%= ytPending %></p>
  </div>

</div>

<div class="mt-8 rounded-2xl border border-border bg-panel2 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-4">
  <div>
    <h2 class="text-lg sm:text-xl font-bold text-white">Ready to post?</h2>
    <p class="text-slate-400 text-sm mt-1">Upload your next pending reel to both platforms in one click.</p>
  </div>
  <a href="/next"
    class="shrink-0 inline-flex items-center gap-2 bg-gradient-to-r from-accent to-accent2 text-slate-900 font-bold px-6 py-3 rounded-xl hover:opacity-90 transition">
    🚀 Go to Next Upload
  </a>
</div>
