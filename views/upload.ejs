<div class="max-w-2xl mx-auto space-y-4 sm:space-y-6">

  <div>
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-50 text-indigo-700 border border-indigo-200/60 mb-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      <span>Manual Content Ingestion</span>
    </span>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Upload New Reel</h1>
    <p class="text-slate-500 mt-1 text-xs sm:text-sm md:text-base">
      Upload an MP4 video directly to Cloudinary CDN and append its metadata to your Google Sheets publishing queue.
    </p>
  </div>

  <form action="/upload-cloudinary" method="POST" enctype="multipart/form-data"
    class="rounded-2xl border border-slate-200/80 bg-white p-4 sm:p-6 md:p-8 shadow-card space-y-4 sm:space-y-5">

    <!-- Video File Dropzone -->
    <div>
      <label class="block mb-2 text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2"/></svg>
        <span>Video File (MP4)</span>
      </label>
      <label for="videoInput"
        class="flex flex-col items-center justify-center gap-2 border-2 border-dashed border-indigo-200 bg-indigo-50/20 rounded-2xl p-5 sm:p-8 text-center cursor-pointer hover:border-indigo-400 hover:bg-indigo-50/50 transition group">
        <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-indigo-100/70 text-indigo-600 flex items-center justify-center group-hover:scale-110 transition-transform shadow-sm shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M12 12v9"/><path d="m16 16-4-4-4 4"/></svg>
        </div>
        <span id="fileLabel" class="text-slate-600 font-semibold text-xs sm:text-sm mt-1">
          Click to choose an MP4 video, or drag and drop it here
        </span>
        <span class="text-[11px] sm:text-xs text-slate-400">Vertical 9:16 format recommended (1080 × 1920 or 1080 × 1350)</span>
      </label>
      <input id="videoInput" type="file" name="video" accept="video/mp4" required class="hidden">
    </div>

    <!-- YouTube Title -->
    <div>
      <label class="block mb-1.5 sm:mb-2 text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-600 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        <span>YouTube Shorts Title</span>
      </label>
      <input type="text" name="title" placeholder="e.g. Read This Dua When Everything Feels Heavy | Day 1"
        class="w-full p-3 sm:p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition text-xs sm:text-sm font-medium">
    </div>

    <!-- Instagram Caption -->
    <div>
      <label class="block mb-1.5 sm:mb-2 text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-rose-600 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        <span>Instagram Caption (Hooks, Arabic Verses &amp; Hashtags)</span>
      </label>
      <textarea name="caption" rows="5" required placeholder="Write or paste your full Instagram caption here..."
        class="w-full p-3 sm:p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition text-xs sm:text-sm font-medium leading-relaxed"></textarea>
    </div>

    <!-- YouTube Description -->
    <div>
      <label class="block mb-1.5 sm:mb-2 text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        <span>YouTube Shorts Description</span>
      </label>
      <textarea name="description" rows="3" placeholder="Optional description for YouTube Shorts with hashtags..."
        class="w-full p-3 sm:p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition text-xs sm:text-sm font-medium leading-relaxed"></textarea>
    </div>

    <!-- Submit Button -->
    <div class="pt-1 sm:pt-2">
      <button type="submit" id="submitBtn"
        class="w-full inline-flex items-center justify-center gap-2 bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-extrabold px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl text-sm sm:text-base shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
        <span>Upload &amp; Append to Queue</span>
      </button>
    </div>

  </form>

</div>

<script>
  const videoInput = document.getElementById('videoInput');
  const fileLabel = document.getElementById('fileLabel');
  const form = document.querySelector('form');
  const submitBtn = document.getElementById('submitBtn');

  videoInput.addEventListener('change', () => {
    if (videoInput.files.length) {
      const file = videoInput.files[0];
      const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
      fileLabel.innerHTML = `
        <div class="flex items-center gap-1.5 text-indigo-700 font-bold text-xs sm:text-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          <span class="truncate max-w-[200px] sm:max-w-xs">${file.name}</span>
          <span class="text-slate-400 text-xs font-normal">(${sizeMb} MB)</span>
        </div>
      `;
    } else {
      fileLabel.textContent = 'Click to choose an MP4 video, or drag and drop it here';
    }
  });

  form.addEventListener('submit', () => {
    submitBtn.disabled = true;
    submitBtn.innerHTML = `<span class="inline-block w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></span> Uploading to Cloudinary...`;
  });
</script>
