<div class="max-w-2xl mx-auto">

  <!-- Clock + countdown -->
  <div class="rounded-2xl border border-border bg-panel2 p-5 sm:p-6 mb-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="text-center sm:text-left">
      <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Current Time</p>
      <p id="clock" class="text-3xl font-extrabold text-white tabular-nums">--:--:--</p>
    </div>
    <div class="hidden sm:block w-px h-12 bg-border"></div>
    <div class="text-center sm:text-left">
      <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Next Scheduled Slot (<span id="slotTimeLabel">--:--</span>)</p>
      <p id="countdown" class="text-3xl font-extrabold bg-gradient-to-r from-accent to-accent2 bg-clip-text text-transparent tabular-nums">--:--:--</p>
    </div>
  </div>

  <!-- Loading -->
  <div id="loadingState" class="rounded-2xl border border-border bg-panel p-10 text-center text-slate-400">
    Loading next reel...
  </div>

  <!-- Empty queue -->
  <div id="emptyState" class="hidden rounded-2xl border border-border bg-panel p-10 text-center">
    <p class="text-5xl mb-3">🎉</p>
    <h2 class="text-xl font-bold text-white">You're all caught up!</h2>
    <p class="text-slate-400 mt-1">No pending reels. Upload a new one to keep the queue going.</p>
    <a href="/upload" class="inline-flex mt-5 items-center gap-2 bg-gradient-to-r from-accent to-accent2 text-slate-900 font-bold px-5 py-2.5 rounded-xl hover:opacity-90 transition">
      📤 Upload a Reel
    </a>
  </div>

  <!-- Reel card -->
  <div id="reelCard" class="hidden rounded-2xl border border-border bg-panel shadow-glow overflow-hidden">
    <div class="p-5 sm:p-6 border-b border-border flex items-center justify-between gap-3">
      <div>
        <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Up Next</p>
        <h1 id="fileName" class="text-lg sm:text-xl font-bold text-white truncate max-w-[70vw]">—</h1>
      </div>
      <div class="flex gap-2 shrink-0">
        <span id="igBadge" class="text-xs font-semibold px-2.5 py-1 rounded-full border">IG</span>
        <span id="ytBadge" class="text-xs font-semibold px-2.5 py-1 rounded-full border">YT</span>
      </div>
    </div>

    <video id="videoPreview" controls class="w-full max-h-[420px] bg-black">
      <source id="videoSourceMain" src="" type="video/mp4">
      <source id="videoSourceFallback" src="" type="video/mp4">
    </video>

    <div class="p-5 sm:p-6 space-y-3">
      <div>
        <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-1">Caption</p>
        <p id="caption" class="text-slate-200">—</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-1">YouTube Title</p>
        <p id="title" class="text-slate-200">—</p>
      </div>

      <button id="uploadBtn" onclick="uploadNow()"
        class="w-full mt-4 inline-flex items-center justify-center gap-2 bg-gradient-to-r from-accent to-accent2 text-slate-900 font-bold px-6 py-4 rounded-xl text-base hover:opacity-90 active:scale-[0.99] transition disabled:opacity-50 disabled:cursor-not-allowed">
        🚀 Upload to Instagram &amp; YouTube
      </button>

      <div id="logPanel" class="hidden bg-black/40 border border-border rounded-xl p-4 mt-2 text-sm font-mono text-slate-300 space-y-1 max-h-40 overflow-auto"></div>
    </div>
  </div>
</div>

<!-- Toast -->
<div id="toast" class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-50 max-w-[90vw] px-5 py-3 rounded-xl shadow-lg font-semibold text-sm"></div>

<script>
  const SCHEDULE_HOURS = [9, 18]; // your set posting times (24h, local time)

  // ---------- Clock + countdown ----------
  function pad(n) { return n.toString().padStart(2, "0"); }

  function nextSlot() {
    const now = new Date();
    const candidates = SCHEDULE_HOURS.map(h => {
      const d = new Date(now);
      d.setHours(h, 0, 0, 0);
      if (d <= now) d.setDate(d.getDate() + 1);
      return d;
    });
    return candidates.sort((a, b) => a - b)[0];
  }

  function tick() {
    const now = new Date();
    document.getElementById("clock").textContent =
      `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;

    const slot = nextSlot();
    document.getElementById("slotTimeLabel").textContent =
      SCHEDULE_HOURS.map(h => `${pad(h)}:00`).join(" / ");

    const diff = Math.max(0, slot - now);
    const h = Math.floor(diff / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    document.getElementById("countdown").textContent = `${pad(h)}:${pad(m)}:${pad(s)}`;
  }
  tick();
  setInterval(tick, 1000);

  // ---------- Toast + notifications ----------
  if ("Notification" in window && Notification.permission === "default") {
    Notification.requestPermission();
  }

  function showToast(message, kind = "success") {
    const toast = document.getElementById("toast");
    toast.textContent = message;
    toast.className = "fixed bottom-5 left-1/2 -translate-x-1/2 z-50 max-w-[90vw] px-5 py-3 rounded-xl shadow-lg font-semibold text-sm " +
      (kind === "success" ? "bg-emerald-500 text-slate-900" : kind === "error" ? "bg-red-500 text-white" : "bg-slate-700 text-white");
    toast.classList.remove("hidden");
    setTimeout(() => toast.classList.add("hidden"), 4000);
  }

  function notify(message) {
    showToast(message, "success");
    if ("Notification" in window && Notification.permission === "granted") {
      new Notification("Reels Automation", { body: message });
    }
  }

  function log(msg) {
    const panel = document.getElementById("logPanel");
    panel.classList.remove("hidden");
    const line = document.createElement("div");
    line.textContent = msg;
    panel.appendChild(line);
    panel.scrollTop = panel.scrollHeight;
  }

  // ---------- Reel loading ----------
  let current = null;

  async function loadNextReel() {
    document.getElementById("loadingState").classList.remove("hidden");
    document.getElementById("emptyState").classList.add("hidden");
    document.getElementById("reelCard").classList.add("hidden");

    const res = await fetch("/api/next-reel");
    const data = await res.json();

    document.getElementById("loadingState").classList.add("hidden");

    if (!data.reel) {
      document.getElementById("emptyState").classList.remove("hidden");
      current = null;
      return;
    }

    current = data.reel;
    document.getElementById("fileName").textContent = data.reel.fileName || "Untitled";
    document.getElementById("caption").textContent = data.reel.caption || "—";
    document.getElementById("title").textContent = data.reel.title || "—";
    document.getElementById("videoSourceMain").src = data.mainUrl;
    document.getElementById("videoSourceFallback").src = data.fallbackUrl;
    document.getElementById("videoPreview").load();

    setBadge("igBadge", "IG", data.reel.igPosted);
    setBadge("ytBadge", "YT", data.reel.ytPosted);

    document.getElementById("logPanel").classList.add("hidden");
    document.getElementById("logPanel").innerHTML = "";

    const btn = document.getElementById("uploadBtn");
    btn.disabled = false;
    btn.innerHTML = "🚀 Upload to Instagram &amp; YouTube";

    document.getElementById("reelCard").classList.remove("hidden");
  }

  function setBadge(id, label, posted) {
    const el = document.getElementById(id);
    el.textContent = posted ? `${label} ✅` : `${label} pending`;
    el.className = "text-xs font-semibold px-2.5 py-1 rounded-full border " +
      (posted ? "border-emerald-500/40 text-emerald-400 bg-emerald-500/10" : "border-border text-slate-400");
  }

  async function uploadNow() {
    if (!current) return;
    const btn = document.getElementById("uploadBtn");
    btn.disabled = true;
    btn.textContent = "⏳ Uploading to both platforms...";

    log(`Starting upload for "${current.fileName}"...`);

    try {
      const res = await fetch("/api/upload-reel", { method: "POST" });
      const data = await res.json();

      if (data.error) {
        log("❌ " + data.error);
        showToast(data.error, "error");
        btn.disabled = false;
        btn.textContent = "🔁 Retry Upload";
        return;
      }

      if (data.instagram?.skipped) log("ℹ️ Instagram: already posted, skipped.");
      else if (data.instagram?.success) log("✅ Instagram: posted successfully.");
      else log("❌ Instagram: " + data.instagram?.error);

      if (data.youtube?.skipped) log("ℹ️ YouTube: already posted, skipped.");
      else if (data.youtube?.success) log("✅ YouTube: posted successfully.");
      else log("❌ YouTube: " + data.youtube?.error);

      if (data.success) {
        notify(`✅ "${data.fileName}" uploaded to Instagram & YouTube!`);
        setTimeout(loadNextReel, 1500);
      } else {
        showToast("Uploaded partially — check the log below.", "error");
        btn.disabled = false;
        btn.textContent = "🔁 Retry Remaining";
      }
    } catch (err) {
      log("❌ " + err.message);
      showToast("Something went wrong: " + err.message, "error");
      btn.disabled = false;
      btn.textContent = "🔁 Retry Upload";
    }
  }

  loadNextReel();
</script>
